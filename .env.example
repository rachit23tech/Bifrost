# Server
PORT=3001
NODE_ENV=development

# Auth — CHANGE THIS in production
JWT_SECRET=change-me-to-a-random-secret-string

# Google Sign-In — create an OAuth Client ID (type: Web application) in
# Google Cloud Console > APIs & Services > Credentials. This is a public
# identifier, not a secret — no Client Secret is needed for this flow.
# Add both http://localhost:5173 (dev) and your deployed URL to
# "Authorized JavaScript origins" on the OAuth client.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Same value, exposed to the Vite frontend build.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
